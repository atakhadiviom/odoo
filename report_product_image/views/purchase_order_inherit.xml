<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Purchase Order PDF report to add product images -->
    <template id="report_purchaseorder_inherit_product_image"
              inherit_id="purchase.report_purchaseorder_document">

        <!-- Add image column header before the Description header -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_product_image" class="text-center report_product_image_cell">Image</th>
        </xpath>

        <!-- Add image cell for each product line -->
        <xpath expr="//td[@name='td_product_name']" position="before">
            <td name="td_product_image" class="text-center align-middle report_product_image_cell">
                <t t-if="line.product_id and line.product_id.image_128">
                    <img t-att-src="image_data_uri(line.product_id.image_128)"
                         class="report_product_image_img"/>
                </t>
            </td>
        </xpath>

    </template>
</odoo>
