<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_ecommerce_banner_list" model="ir.ui.view">
        <field name="name">mobile.ecommerce.banner.list</field>
        <field name="model">mobile.ecommerce.banner</field>
        <field name="arch" type="xml">
            <list string="Mobile Banners">
                <field name="sequence"/>
                <field name="name"/>
                <field name="title"/>
                <field name="action_kind"/>
                <field name="website_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_ecommerce_banner_form" model="ir.ui.view">
        <field name="name">mobile.ecommerce.banner.form</field>
        <field name="model">mobile.ecommerce.banner</field>
        <field name="arch" type="xml">
            <form string="Mobile Banner">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="website_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="title"/>
                            <field name="subtitle"/>
                            <field name="action_kind"/>
                        </group>
                    </group>
                    <group>
                        <field name="image" widget="image" class="oe_avatar"/>
                    </group>
                    <group>
                        <field name="product_tmpl_id" invisible="action_kind != 'product'"/>
                        <field name="category_id" invisible="action_kind != 'category'"/>
                        <field name="external_url" invisible="action_kind != 'url'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_ecommerce_banner" model="ir.actions.act_window">
        <field name="name">Mobile Banners</field>
        <field name="res_model">mobile.ecommerce.banner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
