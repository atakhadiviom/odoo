<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_packaging_form_inherit" model="ir.ui.view">
        <field name="name">product.template.packaging.form.inherit.syntho</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group name="packaging" string="Packaging / Barcodes" invisible="product_variant_count != 1">
                    <field name="product_uom_ids" nolabel="1" context="{'default_product_id': product_variant_id}">
                        <list editable="bottom">
                            <field name="barcode"/>
                            <field name="uom_id"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
