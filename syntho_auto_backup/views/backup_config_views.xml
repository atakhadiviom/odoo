<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_backup_config_tree" model="ir.ui.view">
        <field name="name">auto.backup.config.tree</field>
        <field name="model">auto.backup.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="folder"/>
                <field name="format"/>
            </list>
        </field>
    </record>

    <record id="view_backup_config_form" model="ir.ui.view">
        <field name="name">auto.backup.config.form</field>
        <field name="model">auto.backup.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="folder"/>
                        <field name="format"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_backup_config" model="ir.actions.act_window">
        <field name="name">Backup Configuration</field>
        <field name="res_model">auto.backup.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_backup_config"
              name="Auto Backup"
              parent="base.menu_custom"
              action="action_backup_config"
              sequence="100"/>
</odoo>
